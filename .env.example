# ==============================================================================
# PrintEasy Environment Variables Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (FastAPI)
# ------------------------------------------------------------------------------

# [REQUIRED] Neon PostgreSQL connection string
# Found in: Neon Console -> Project Dashboard -> Connection Details
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# [REQUIRED] Secret key for signing and verifying user JWT session tokens (256-bit / 32-byte hex)
# Generate via terminal: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-random-256-bit-secret-hex-key

# [RECOMMENDED for Production CORS] The URL where your frontend is deployed
# Example: https://printeasy.vercel.app or https://print.school.edu
FRONTEND_URL=https://your-frontend-domain.com

# [RECOMMENDED for Cloud Storage] Vercel Blob Read/Write Token
# If set, uploaded documents are stored in Vercel Blob and auto-purged on print/expire.
# If omitted, files are saved locally to backend/uploads/ directory.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# [OPTIONAL] Server port (defaults to 8000 or platform $PORT)
PORT=8000


# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (React / Vite)
# ------------------------------------------------------------------------------

# [OPTIONAL] Backend API Base URL
# - If frontend and backend are deployed on DIFFERENT domains (e.g. Frontend on Vercel, Backend on Railway/Render):
#   Set this to your backend's public URL:
#   VITE_API_BASE_URL=https://your-backend-api.up.railway.app
# - If using same-domain routing, reverse proxy, or local Vite dev proxy:
#   Leave empty or omit.
VITE_API_BASE_URL=
